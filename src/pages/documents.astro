---
import Base from '../layouts/Base.astro';
import { getLibrary, LIBRARY_CATEGORIES } from '../lib/library';
const items = await getLibrary();
const groups = Object.entries(LIBRARY_CATEGORIES)
  .map(([k, label]) => ({ k, label, items: items.filter((i) => i.category === k) }))
  .filter((g) => g.items.length);
---
<Base title="Technical document library" description="Plan sheets, cross sections, details, estimates, hazard maps, analysis figures and reports from my projects, grouped by discipline." crumbs={[{ label: 'Resume', href: '/resume' }, { label: 'Document library' }]}>
  <header class="page-head">
    <h1>Technical document library</h1>
    <p>Every figure and document published on this site, grouped by discipline. Select one to open it at full size, or open its project for the context and my part in it.</p>
  </header>
  <nav class="toc" aria-label="Categories">
    {groups.map((g) => <a href={`#${g.k}`}>{g.label} <span>{g.items.length}</span></a>)}
  </nav>
  {groups.map((g) => (
    <section class="section lib" id={g.k} aria-labelledby={`h-${g.k}`}>
      <h2 id={`h-${g.k}`}>{g.label}</h2>
      <ul class="lib-grid">
        {g.items.map((it) => (
          <li>
            <a class="lib-file" href={it.file} target="_blank" rel="noopener">
              {it.thumb
                ? <img src={it.thumb} alt={it.caption} loading="lazy" decoding="async" width="640" height="450" />
                : <span class="pdf">PDF</span>}
            </a>
            <p class="lib-cap">{it.caption}</p>
            <p class="lib-proj"><a href={`/projects/${it.projectId}`}>{it.code}</a></p>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p class="small muted note">Editable source files (Civil 3D drawings, GEO5 models, Excel workbooks) are kept private and are not published here.</p>
</Base>
<style>
  .toc { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .toc a { font-size: var(--t-sm); padding: 5px 12px; border: 1px solid var(--rule); border-radius: 999px; color: var(--ink); text-decoration: none; background: var(--white); }
  .toc a:hover { border-color: var(--red); color: var(--red); }
  .toc span { color: var(--steel); margin-left: 4px; }
  .lib h2 { font-size: var(--t-md); }
  .lib-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px 18px; }
  .lib-file { display: block; aspect-ratio: 4 / 3; border: 1px solid var(--rule); background: var(--white); overflow: hidden; }
  .lib-file:hover { border-color: var(--red); }
  .lib-file img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .pdf { display: grid; place-items: center; height: 100%; font-weight: 700; color: var(--red); letter-spacing: 0.08em; }
  .lib-cap { font-size: 0.82rem; margin: 6px 0 2px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .lib-proj { font-size: 0.78rem; margin: 0; }
  .note { margin-top: 32px; }
  @media (max-width: 960px) { .lib-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .lib-grid { grid-template-columns: 1fr 1fr; } }
</style>
