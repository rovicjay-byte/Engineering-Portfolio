---
import type { Project } from '../lib/publish';
import { DISCIPLINE_SHORT, WORK_TYPE_LABELS, isPublic } from '../lib/publish';

interface Props { projects: Project[]; filters?: boolean; group?: boolean; empty?: string }
const { projects, filters = false, group = false, empty = 'No projects to show yet.' } = Astro.props;

const GROUPS: { type: string; title: string; note: string }[] = [
  { type: 'PRO', title: 'Professional projects', note: 'Design, drafting and analysis done at DPWH. Signatures on the plan sheets are covered.' },
  { type: 'RES', title: 'Research', note: 'Graduate and undergraduate research.' },
  { type: 'TRN', title: 'Training', note: 'Work done as a trainee.' },
  { type: 'ACA', title: 'Academic work', note: 'Plates and plan sets from my BS Civil Engineering coursework.' },
  { type: 'IND', title: 'Independent work', note: 'Self-initiated tools and studies.' },
];
const sections = group
  ? GROUPS.map((g) => ({ ...g, items: projects.filter((p) => p.data.work_type === g.type) })).filter((g) => g.items.length)
  : [{ type: 'all', title: '', note: '', items: projects }];

const uniq = (xs: (string | number)[]) => [...new Set(xs)].sort();
const disciplines = uniq(projects.flatMap((p) => p.data.disciplines)) as string[];
const types = uniq(projects.map((p) => p.data.work_type)) as string[];
const software = uniq(projects.flatMap((p) => p.data.software)) as string[];
const competencies = uniq(projects.flatMap((p) => p.data.competencies)) as string[];
const years = (uniq(projects.map((p) => p.data.year)) as number[]).reverse();
---
<div class="register" data-register>
  {filters && projects.length > 0 && (
    <form class="filters" role="search" aria-label="Filter projects">
      <div class="f-search">
        <label for="f-q">Search projects</label>
        <div class="f-bar">
          <input id="f-q" type="search" name="q" placeholder="Try slope stability, Civil 3D, bridge" autocomplete="off" />
          <button type="submit" class="f-go">Search</button>
          <button type="reset" class="f-clear">Clear filters</button>
        </div>
      </div>
      <label><span>Discipline</span>
        <select name="discipline"><option value="">All</option>{disciplines.map((d) => <option value={d}>{DISCIPLINE_SHORT[d]}</option>)}</select>
      </label>
      <label><span>Work type</span>
        <select name="type"><option value="">All</option>{types.map((t) => <option value={t}>{WORK_TYPE_LABELS[t]}</option>)}</select>
      </label>
      <label><span>Software</span>
        <select name="software"><option value="">All</option>{software.map((s) => <option value={s}>{s}</option>)}</select>
      </label>
      <label><span>Competency</span>
        <select name="competency"><option value="">All</option>{competencies.map((c) => <option value={c}>{c}</option>)}</select>
      </label>
      <label><span>Year</span>
        <select name="year"><option value="">All</option>{years.map((y) => <option value={y}>{y}</option>)}</select>
      </label>
      <p class="count" aria-live="polite" data-count></p>
    </form>
  )}

  {projects.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    sections.map((g) => (
      <section class={`group group-${g.type}`} data-group aria-labelledby={g.title ? `g-${g.type}` : undefined}>
        {g.title && (
          <header class="g-head">
            <h2 id={`g-${g.type}`}>{g.title} <span class="g-count" data-group-count>{g.items.length}</span></h2>
            <p>{g.note}</p>
          </header>
        )}
        <ol class="rows">
          {g.items.map((p) => (
            <li
              class="row"
              data-discipline={p.data.disciplines.join('|')}
              data-type={p.data.work_type}
              data-software={p.data.software.join('|')}
              data-competency={p.data.competencies.join('|')}
              data-year={p.data.year}
              data-text={[p.data.title, p.data.summary, p.data.project_type, ...p.data.software, ...p.data.competencies].join(' ').toLowerCase()}
            >
              <a href={`/projects/${p.id}`} class="card">
                <span class="thumb">
                  {p.data.cover
                    ? <img src={`/previews/${p.data.code}/${p.data.cover}`} alt="" loading="lazy" width="1200" height="900" />
                    : <span class="no-img">{p.data.code}</span>}
                </span>
                <span class="meta">
                  <span class="code">{p.data.code}</span>
                  {!group && <span class={`wt wt-${p.data.work_type}`}>{WORK_TYPE_LABELS[p.data.work_type]}</span>}
                  <span class="year">{p.data.year}{p.data.status === 'ongoing' ? ', ongoing' : ''}</span>
                  {!isPublic(p) && <span class="draft-flag">{p.data.publication_status === 'draft' ? 'Draft' : 'In review'}</span>}
                </span>
                <span class="title">{p.data.title}</span>
                <span class="summary">{p.data.summary}</span>
                <span class="tags">
                  {p.data.disciplines.map((d) => <span>{DISCIPLINE_SHORT[d]}</span>)}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  )}
  {filters && <p class="empty" data-none hidden>No projects match these filters. Clear a filter to see more.</p>}
</div>

<style>
  .filters {
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; align-items: end;
    padding: 18px; margin-bottom: 16px; background: var(--white); border: 1px solid var(--rule); border-top: 3px solid var(--red);
  }
  .f-search { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 6px; font-size: 0.8125rem; color: var(--steel); }
  .f-bar { display: flex; gap: 8px; }
  .f-bar input { flex: 1; height: 44px !important; font-size: 1rem !important; padding: 6px 18px !important; }
  .f-go, .f-clear {
    font: inherit; font-weight: 600; font-size: 0.92rem; border-radius: 999px; padding: 0 20px; height: 44px; cursor: pointer; white-space: nowrap;
  }
  .f-go { background: var(--red); color: var(--white); border: 1px solid var(--red); }
  .f-go:hover { background: #b51e15; }
  .f-clear { background: var(--white); color: var(--ink-strong); border: 1px solid var(--rule); }
  .f-clear:hover { border-color: var(--ink-strong); }
  .filters label { display: flex; flex-direction: column; gap: 4px; font-size: 0.8125rem; color: var(--steel); min-width: 0; }
  .filters input, .filters select {
    font: inherit; font-size: 0.9375rem; color: var(--ink); padding: 8px 10px; border: 1px solid var(--rule);
    border-radius: 999px; background: var(--white); width: 100%; min-width: 0; height: 38px; padding: 6px 14px;
  }
  .count { grid-column: 1 / -1; margin: 0; font-size: 0.8125rem; color: var(--steel); }
  @media (max-width: 900px) { .filters { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .f-bar { flex-wrap: wrap; } .f-bar input { flex-basis: 100%; } .f-go, .f-clear { flex: 1; } }

  .group + .group { margin-top: 56px; }
  .g-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 24px;
    border-top: 2px solid var(--ink-strong); padding-top: 14px; margin-bottom: 22px; }
  .g-head h2 { margin: 0; font-size: 1.5rem; display: flex; align-items: center; gap: 10px; }
  .g-head p { margin: 0; color: var(--steel); font-size: 0.92rem; }
  .g-count { display: inline-grid; place-items: center; min-width: 28px; height: 28px; padding: 0 8px; border-radius: 999px;
    background: var(--red); color: var(--white); font-size: 0.85rem; font-weight: 700; }
  .rows { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 32px 26px; }
  .row[hidden], .group[hidden] { display: none; }
  .group-PRO .rows, .group-RES .rows { grid-template-columns: repeat(2, 1fr); gap: 40px 32px; }
  .group-PRO .title, .group-RES .title { font-size: 1.2rem; }
  .group-ACA .rows, .group-TRN .rows, .group-IND .rows { grid-template-columns: repeat(4, 1fr); gap: 28px 20px; }
  .group-ACA .title { font-size: 0.98rem; }
  @media (max-width: 1000px) { .group-ACA .rows, .group-TRN .rows, .group-IND .rows { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .group .rows { grid-template-columns: 1fr !important; } }
  .card { display: flex; flex-direction: column; gap: 8px; height: 100%; text-decoration: none; color: var(--ink); }
  .thumb { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--white); border: 1px solid var(--rule); transition: border-color .2s; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .45s ease; }
  .no-img { display: grid; place-items: center; height: 100%; color: var(--steel); font-weight: 600; }
  .card:hover .thumb, .card:focus-visible .thumb { border-color: var(--red); }
  .card:hover .thumb img { transform: scale(1.035); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin-top: 4px; font-size: 0.8rem; }
  .code { font-weight: 700; color: var(--red); }
  .year { color: var(--steel); }
  .title { font-size: 1.06rem; font-weight: 700; color: var(--ink-strong); line-height: 1.3; }
  .card:hover .title { color: var(--red); }
  .summary { color: var(--steel); font-size: 0.9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; padding-top: 4px; }
  .tags span { font-size: 0.74rem; padding: 3px 10px; border: 1px solid var(--rule); border-radius: 999px; color: var(--ink); background: var(--white); }
  .empty { padding: 28px 0; color: var(--steel); border-top: 1px solid var(--ink-strong); margin: 0; }
  @media (prefers-reduced-motion: reduce) { .thumb img { transition: none; } .card:hover .thumb img { transform: none; } }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-register]')) {
    const form = root.querySelector('form');
    if (!form) continue;
    const rows = [...root.querySelectorAll<HTMLElement>('.row')];
    const none = root.querySelector<HTMLElement>('[data-none]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    const fields = ['discipline', 'type', 'software', 'competency', 'year'] as const;

    // Pre-fill from the URL, e.g. /projects?discipline=highway
    const params = new URLSearchParams(location.search);
    for (const f of [...fields, 'q']) {
      const el = form.elements.namedItem(f) as HTMLInputElement | HTMLSelectElement | null;
      if (el && params.get(f)) el.value = params.get(f)!;
    }

    const apply = () => {
      const q = ((form.elements.namedItem('q') as HTMLInputElement).value || '').trim().toLowerCase();
      let shown = 0;
      for (const r of rows) {
        let ok = !q || (r.dataset.text || '').includes(q);
        for (const f of fields) {
          const v = (form.elements.namedItem(f) as HTMLSelectElement).value;
          if (v && !(r.dataset[f] || '').split('|').includes(v)) ok = false;
        }
        r.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of root.querySelectorAll<HTMLElement>('[data-group]')) {
        const n = [...g.querySelectorAll<HTMLElement>('.row')].filter((r) => !r.hidden).length;
        g.hidden = n === 0;
        const c = g.querySelector<HTMLElement>('[data-group-count]');
        if (c) c.textContent = String(n);
      }
      if (none) none.hidden = shown !== 0;
      if (count) count.textContent = `Showing ${shown} of ${rows.length} projects`;
      const next = new URLSearchParams();
      for (const f of [...fields, 'q']) {
        const v = (form.elements.namedItem(f) as HTMLInputElement).value;
        if (v) next.set(f, v);
      }
      history.replaceState(null, '', next.toString() ? `?${next}` : location.pathname);
    };
    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      apply();
      const first = root.querySelector('[data-group]:not([hidden])') || root;
      first.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });
    form.addEventListener('reset', () => setTimeout(apply, 0));
    apply();
  }
</script>
