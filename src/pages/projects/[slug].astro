---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectRegister from '../../components/ProjectRegister.astro';
import {
  getProjects, isPublic, DISCIPLINE_SHORT, WORK_TYPE_LABELS, STATUS_LABELS, type Project,
} from '../../lib/publish';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p, all: projects } }));
}

const { project, all } = Astro.props as { project: Project; all: Project[] };
const d = project.data;
const { Content } = await render(project);

const score = (o: Project) =>
  o.data.disciplines.filter((x) => d.disciplines.includes(x)).length * 2 +
  o.data.competencies.filter((x) => d.competencies.includes(x)).length;
const related = all
  .filter((o) => o.id !== project.id)
  .map((o) => ({ o, s: score(o) }))
  .filter(({ s }) => s > 0)
  .sort((a, b) => b.s - a.s)
  .slice(0, 3)
  .map(({ o }) => o);
---
<Base
  title={d.title}
  description={d.summary}
  noindex={!isPublic(project)}
  crumbs={[{ label: 'Projects', href: '/projects' }, { label: d.code }]}
>
  <article>
    <header class="cs-head">
      <div class="cs-labels">
        <span class="code">{d.code}</span>
        <span class={`wt wt-${d.work_type}`}>{WORK_TYPE_LABELS[d.work_type]}</span>
        {!isPublic(project) && <span class="draft-flag">Not public: {d.publication_status}</span>}
      </div>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>

    <div class="cs-grid">
      <aside class="cs-facts" aria-label="Project facts">
        <dl class="facts">
          <dt>Year</dt><dd>{d.year} ({STATUS_LABELS[d.status].toLowerCase()})</dd>
          <dt>My role</dt><dd>{d.role}</dd>
          {d.location_public && <><dt>Location</dt><dd>{d.location_public}</dd></>}
          {d.client_public && <><dt>Owner</dt><dd>{d.client_public}</dd></>}
          <dt>Type</dt><dd>{d.project_type}</dd>
        </dl>
        <h2 class="side-h">Disciplines</h2>
        <ul class="tags">{d.disciplines.map((x) => <li><a href={`/capabilities/${x}`}>{DISCIPLINE_SHORT[x]}</a></li>)}</ul>
        {d.software.length > 0 && <>
          <h2 class="side-h">Software</h2>
          <ul class="tags">{d.software.map((x) => <li>{x}</li>)}</ul>
        </>}
        {d.competencies.length > 0 && <>
          <h2 class="side-h">Competencies</h2>
          <ul class="tags">{d.competencies.map((x) => <li>{x}</li>)}</ul>
        </>}
        {d.confidentiality === 'generalized' && (
          <p class="note small">Generalized case study: names, locations, costs and issued drawings are withheld or recreated. <a href="/notice">Why</a></p>
        )}
      </aside>

      <div class="cs-body prose">
        <Content />

        {d.downloads.length > 0 && (
          <section aria-label="Downloads">
            <h2>Downloads</h2>
            <ul>{d.downloads.map((dl) => <li><a href={`/previews/${d.code}/${dl.file}`} download>{dl.label}</a></li>)}</ul>
          </section>
        )}
      </div>
    </div>

    {d.previews.length > 0 && (
      <section class="section gallery" aria-label="Drawings and figures">
        <h2>Drawings and figures</h2>
        <div class="g-grid">
          {d.previews.map((pv) => (
            <figure class={pv.wide ? 'wide' : undefined}>
              {pv.file.endsWith('.pdf')
                ? <object data={`/previews/${d.code}/${pv.file}`} type="application/pdf" width="100%" height="560"><a href={`/previews/${d.code}/${pv.file}`}>Open PDF</a></object>
                : <a href={`/previews/${d.code}/${pv.file}`} data-lb data-caption={pv.caption} aria-label={`Open full size: ${pv.caption}`}><img src={`/previews/${d.code}/${pv.file}`} alt={pv.caption} loading="lazy" /></a>}
              <figcaption>{pv.caption}</figcaption>
            </figure>
          ))}
        </div>
        <p class="small muted">Select a drawing to open it at full size.</p>
      </section>
    )}

    <dialog class="lb" aria-label="Image viewer" data-lightbox>
      <div class="lb-bar">
        <span class="lb-count" data-lb-count></span>
        <button type="button" class="lb-close" data-lb-close aria-label="Close image viewer">
          <span aria-hidden="true">✕</span> Close
        </button>
      </div>
      <div class="lb-stage" data-lb-stage>
        <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Previous image"><span aria-hidden="true">‹</span></button>
        <img data-lb-img alt="" />
        <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Next image"><span aria-hidden="true">›</span></button>
      </div>
      <p class="lb-cap" data-lb-cap></p>
    </dialog>

    {related.length > 0 && (
      <section class="section">
        <h2>Related projects</h2>
        <ProjectRegister projects={related} />
      </section>
    )}
  </article>
</Base>

<style>
  .cs-head { padding-bottom: 28px; border-bottom: 1px solid var(--rule); margin-bottom: 36px; }
  .cs-labels { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 14px; }
  .code { font-weight: 600; color: var(--red); font-size: var(--t-sm); }
  .cs-head h1 { max-width: 30ch; font-size: clamp(1.8rem, 3.6vw, 2.6rem); }
  .summary { font-size: var(--t-md); color: var(--steel); max-width: 62ch; line-height: 1.45; margin: 0; }
  .cs-grid { display: grid; grid-template-columns: 300px 1fr; gap: 48px; align-items: start; }
  .cs-facts { position: sticky; top: 24px; background: var(--white); border-top: 3px solid var(--red); padding: 20px; }
  .side-h { font-size: 0.8rem; color: var(--red); font-weight: 600; margin: 20px 0 8px; letter-spacing: 0; }
  .tags a { text-decoration: none; color: inherit; }
  .tags a:hover { color: var(--accent); }
  .note { margin: 20px 0 0; color: var(--steel); }
  .cs-body :global(h2) { font-size: var(--t-md); margin-top: 2em; padding-top: 0.8em; border-top: 1px solid var(--rule-soft); }
  .cs-body :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .gallery h2 { margin-bottom: 20px; }
  .g-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px 24px; }
  .g-grid figure { margin: 0; }
  .g-grid figure.wide { grid-column: 1 / -1; }
  .g-grid figure.wide img { width: auto; max-width: 100%; max-height: 1150px; }
  .g-grid img { width: 100%; border: 1px solid var(--rule); background: var(--white); }
  .g-grid a:hover img { border-color: var(--accent); }
  .g-grid figcaption { font-size: var(--t-sm); color: var(--steel); margin-top: 8px; }
  @media (max-width: 760px) { .g-grid { grid-template-columns: 1fr; } }
  .g-grid a[data-lb] { cursor: zoom-in; display: block; }

  /* Image viewer */
  .lb {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(20, 20, 20, 0.97); color: #fff;
  }
  .lb[open] { display: grid; grid-template-rows: auto 1fr auto; }
  .lb::backdrop { background: rgba(20, 20, 20, 0.6); }
  .lb-bar { display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; }
  .lb-count { font-size: var(--t-sm); color: #cfcfcf; }
  .lb-close {
    font: inherit; font-weight: 600; font-size: 0.95rem; color: #fff; background: var(--red); border: 0;
    border-radius: 999px; padding: 10px 18px; cursor: pointer; display: inline-flex; gap: 8px; align-items: center;
  }
  .lb-close:hover { background: #b51e15; }
  .lb-close:focus-visible, .lb-nav:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .lb-stage { position: relative; display: grid; place-items: center; min-height: 0; padding: 0 64px; }
  .lb-stage img { max-width: 100%; max-height: calc(100dvh - 150px); object-fit: contain; background: #fff; box-shadow: 0 10px 40px rgba(0,0,0,.4); }
  .lb-nav {
    position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,.35); background: rgba(0,0,0,.35); color: #fff; font-size: 1.8rem; line-height: 1;
    cursor: pointer; display: grid; place-items: center;
  }
  .lb-nav:hover { background: var(--red); border-color: var(--red); }
  .lb-prev { left: 10px; } .lb-next { right: 10px; }
  .lb-nav[hidden] { display: none; }
  .lb-cap { margin: 0; padding: 12px 18px 18px; text-align: center; font-size: 0.92rem; color: #e6e6e6; }
  @media (max-width: 640px) { .lb-stage { padding: 0 8px; } .lb-nav { top: auto; bottom: -58px; transform: none; } .lb-cap { padding: 14px 64px 20px; } }
  @media (max-width: 900px) {
    .cs-grid { grid-template-columns: 1fr; gap: 32px; }
    .cs-facts { position: static; }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-lb]')];
  if (dlg && links.length && typeof dlg.showModal === 'function') {
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
    const count = dlg.querySelector<HTMLElement>('[data-lb-count]')!;
    const prev = dlg.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dlg.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    const stage = dlg.querySelector<HTMLElement>('[data-lb-stage]')!;
    let i = 0;
    let opener: HTMLElement | null = null;

    const show = (n: number) => {
      i = (n + links.length) % links.length;
      const a = links[i];
      img.src = a.href;
      img.alt = a.dataset.caption || '';
      cap.textContent = a.dataset.caption || '';
      count.textContent = links.length > 1 ? `${i + 1} of ${links.length}` : '';
      prev.hidden = next.hidden = links.length < 2;
    };
    const close = () => dlg.close();

    links.forEach((a, n) => a.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      opener = a;
      show(n);
      dlg.showModal();
      document.documentElement.style.overflow = 'hidden';
    }));
    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      img.removeAttribute('src');
      opener?.focus();
    });
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', close);
    prev.addEventListener('click', () => show(i - 1));
    next.addEventListener('click', () => show(i + 1));
    // Clicking the dark area around the image closes the viewer
    stage.addEventListener('click', (e) => { if (e.target === stage) close(); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
  }
</script>
