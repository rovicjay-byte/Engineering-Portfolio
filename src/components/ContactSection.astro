---
// Contact block: e-mail, LinkedIn and CV (CV shows only when a file is set in profile.yaml).
import { getProfile } from '../lib/publish';
interface Props { title?: string }
const { title = 'Contact' } = Astro.props;
const me = await getProfile();
---
<section class="contact-block" aria-labelledby="contact-h">
  <div>
    <h2 id="contact-h">{title}</h2>
    <p class="muted">Open to roles in highway, geotechnical and civil design work. E-mail is the quickest way to reach me.</p>
  </div>
  <ul class="c-list">
    {me.email && <li><span class="c-lab">E-mail</span><a href={`mailto:${me.email}`}>{me.email}</a></li>}
    {me.linkedin && <li><span class="c-lab">LinkedIn</span><a href={encodeURI(me.linkedin)} rel="me noopener" target="_blank">{me.linkedin.replace(/^https?:\/\/(www\.)?/, '')}</a></li>}
    {me.resume_pdf && <li><span class="c-lab">CV</span><a href={me.resume_pdf} download>Download CV (PDF)</a></li>}
    <li><span class="c-lab">Based in</span><span>{me.location}</span></li>
  </ul>
</section>

<style>
  .contact-block { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 48px; align-items: start; }
  .contact-block h2 { margin: 0 0 8px; }
  .contact-block p { margin: 0; max-width: 46ch; }
  .c-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink-strong); }
  .c-list li { display: grid; grid-template-columns: 100px 1fr; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: 0.95rem; min-width: 0; }
  .c-list a { overflow-wrap: anywhere; }
  .c-lab { color: var(--red); font-weight: 600; font-size: var(--t-sm); }
  @media (max-width: 760px) { .contact-block { grid-template-columns: 1fr; } }
</style>
