---
import '@fontsource-variable/montserrat';
import '@fontsource/allura';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProfile, SHOW_DRAFTS } from '../lib/publish';

interface Props {
  title: string;
  description?: string;
  crumbs?: { label: string; href?: string }[];
  noindex?: boolean;
  bare?: boolean;
  image?: string;
}
const { title, description, crumbs = [], noindex = false, bare = false, image } = Astro.props;
const me = await getProfile();
const brand = 'Rovic-Jay Piñon';
const fullTitle = title === 'Home'
  ? `${brand} | Civil Engineer – Highway Design & Geotechnical Engineering`
  : `${title} | ${brand}, RCE`;
const desc = description ?? me.headline;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image ?? '/img/og-card.jpg', Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: me.name,
  jobTitle: 'Civil Engineer',
  hasCredential: 'Registered Civil Engineer (PRC)',
  ...(me.email ? { email: `mailto:${me.email}` } : {}),
  ...(canonical ? { url: new URL('/', Astro.site).href } : {}),
  address: { '@type': 'PostalAddress', addressRegion: me.location },
  ...(me.linkedin ? { sameAs: [encodeURI(me.linkedin)] } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {(noindex || SHOW_DRAFTS) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rovic-Jay Piñon, RCE" />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {SHOW_DRAFTS && (
      <div class="draft-bar" role="note">
        Draft view: items in review are visible. The public site shows approved items only.
      </div>
    )}
    <Header name={me.short_name} designation={me.designation} title={me.title} cv={me.resume_pdf || undefined} />
    <main id="main">
      <div class="wrap">
        <div class={bare ? undefined : 'sheet'}>
        {crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              {crumbs.map((c) => (
                <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
              ))}
            </ol>
          </nav>
        )}
        <slot />
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .draft-bar {
    background: var(--draft-bg); color: var(--draft); border-bottom: 1px dashed var(--draft);
    font-size: var(--t-sm); font-weight: 600; text-align: center; padding: 6px 16px;
  }
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0 0 24px; font-size: var(--t-sm); color: var(--steel); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--rule); }
  .crumbs a { color: var(--steel); }
  .crumbs a:hover { color: var(--red); }
</style>
