---
import { getProfile } from '../lib/publish';
const me = await getProfile();
const updated = new Date().toISOString().slice(0, 10);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="spread">
      <div class="pg thanks">
        <p class="ty" aria-label="Thank you"><span class="t1">Thank</span><span class="t2 script">you</span></p>
        {me.email && <p class="lab">E-mail</p>}
        {me.email && <p class="val"><a href={`mailto:${me.email}`}>{me.email}</a></p>}
        {me.linkedin && <p class="lab">LinkedIn</p>}
        {me.linkedin && <p class="val"><a href={encodeURI(me.linkedin)} rel="me">{me.linkedin.replace(/^https?:\/\/(www\.)?/, '')}</a></p>}
      </div>
      <div class="pg meta">
        <p class="who">{me.name}</p>
        <p class="muted small">{me.designation} · {me.location}</p>
        <dl class="facts small">
          <dt>Last updated</dt><dd><time datetime={updated}>{updated}</time></dd>
          <dt>About this site</dt><dd><a href="/notice">Work labels and confidentiality</a></dd>
        </dl>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding: 8px 0 48px; }
  .ty { margin: 0 0 22px; line-height: 0.9; }
  .t1 { font-weight: 700; color: var(--red); font-size: clamp(3rem, 7vw, 5rem); letter-spacing: -0.03em; }
  .t2 { font-size: clamp(3rem, 7vw, 5rem); color: var(--ink-strong); margin-left: -0.15em; position: relative; top: 0.35em; }
  .lab { color: var(--red); font-weight: 600; font-size: var(--t-sm); margin: 14px 0 0; }
  .val { margin: 0; font-size: var(--t-sm); }
  .val a { color: var(--ink); text-decoration: none; }
  .val a:hover { color: var(--red); text-decoration: underline; }
  .meta { display: flex; flex-direction: column; justify-content: flex-end; }
  .who { font-weight: 700; color: var(--ink-strong); margin: 0 0 2px; }
  .meta .facts { margin-top: 16px; }
</style>
