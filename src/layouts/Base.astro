---
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProfile, SHOW_DRAFTS } from '../lib/publish';

interface Props {
  title: string;
  description?: string;
  crumbs?: { label: string; href?: string }[];
  noindex?: boolean;
}
const { title, description, crumbs = [], noindex = false } = Astro.props;
const me = await getProfile();
const fullTitle = title === 'Home' ? `${me.short_name}, ${me.designation}` : `${title} | ${me.short_name}`;
const desc = description ?? me.headline;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: me.name,
  jobTitle: me.designation,
  address: { '@type': 'PostalAddress', addressRegion: me.location },
  ...(me.linkedin ? { sameAs: [encodeURI(me.linkedin)] } : {}),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {canonical && <link rel="canonical" href={canonical} />}
    {(noindex || SHOW_DRAFTS) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {SHOW_DRAFTS && (
      <div class="draft-bar" role="note">
        Draft view: items in review are visible. The public site shows approved items only.
      </div>
    )}
    <Header name={me.short_name} designation={me.designation} />
    <main id="main">
      <div class="wrap">
        {crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              {crumbs.map((c) => (
                <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
              ))}
            </ol>
          </nav>
        )}
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .draft-bar {
    background: var(--draft-bg); color: var(--draft); border-bottom: 1px dashed var(--draft);
    font-size: var(--t-sm); font-weight: 600; text-align: center; padding: 6px 16px;
  }
  .crumbs ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: 0 0 24px; font-size: var(--t-sm); color: var(--steel); }
  .crumbs li + li::before { content: '/'; margin-right: 6px; color: var(--rule); }
  .crumbs a { color: var(--steel); }
  .crumbs a:hover { color: var(--navy); }
</style>
