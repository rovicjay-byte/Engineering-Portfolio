---
interface Props { name: string; designation: string }
const { name, designation } = Astro.props;
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/capabilities', label: 'Capabilities' },
  { href: '/what-i-deliver', label: 'What I deliver' },
  { href: '/research', label: 'Research' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">
      <span class="brand-name">{name}</span>
      <span class="brand-title">{designation}</span>
    </a>
    <details class="menu">
      <summary aria-label="Open menu">Menu</summary>
      <nav aria-label="Main">
        <ul>
          {links.map((l) => (
            <li><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header { background: var(--navy); color: var(--white); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 68px; }
  .brand { color: var(--white); text-decoration: none; display: flex; flex-direction: column; line-height: 1.2; padding: 10px 0; }
  .brand-name { font-weight: 750; font-size: 1.05rem; letter-spacing: -0.005em; }
  .brand-title { font-size: 0.8125rem; color: #b8c6da; }
  .brand:hover { color: var(--white); }
  .menu summary { list-style: none; cursor: pointer; font-weight: 600; font-size: var(--t-sm); padding: 8px 12px; border: 1px solid #4a628a; border-radius: 4px; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu a { color: #dbe3ee; text-decoration: none; font-size: 0.9375rem; font-weight: 500; }
  .menu a:hover, .menu a[aria-current='page'] { color: var(--white); }
  .menu a[aria-current='page'] { text-decoration: underline; text-decoration-color: #5fc0c7; text-decoration-thickness: 2px; text-underline-offset: 8px; }

  /* Small screens: dropdown panel */
  @media (max-width: 879px) {
    .menu { position: relative; }
    .menu nav { position: absolute; right: 0; top: calc(100% + 10px); background: var(--navy); border: 1px solid #344c74; border-radius: 6px; padding: 8px 0; min-width: 210px; z-index: 5; }
    .menu li a { display: block; padding: 10px 18px; }
  }
  /* Wide screens: inline nav, no toggle */
  @media (min-width: 880px) {
    .menu summary { display: none; }
    .menu nav { display: block !important; }
    .menu ul { display: flex; gap: 22px; }
  }
</style>

<script>
  // Keep the nav visible on wide screens even when the <details> is closed.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 880px)');
  const sync = () => { if (menu && mq.matches) menu.open = true; };
  sync();
  mq.addEventListener('change', sync);
</script>
