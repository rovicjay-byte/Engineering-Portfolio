---
import Base from '../../layouts/Base.astro';
import ProjectRegister from '../../components/ProjectRegister.astro';
import { getProjects } from '../../lib/publish';
const projects = await getProjects();
---
<Base title="Projects" description="Engineering projects, research and technical work, filterable by discipline, software and competency." crumbs={[{ label: 'Projects' }]}>
  <header class="page-head">
    <h1>Engineering work you can inspect</h1>
    <p>Approved plan sets, estimates, schedules, analyses and reports. Professional DPWH work comes first, then research and academic work. Every page shows the actual deliverables and states exactly what I did.</p>
  </header>
  <ProjectRegister
    projects={projects}
    filters
    group
    empty="Case studies are being prepared for publication. See capabilities for the work I currently do."
  />
</Base>
