---
import Base from '../layouts/Base.astro';
import ProfileHero from '../components/ProfileHero.astro';
import ProjectRegister from '../components/ProjectRegister.astro';
import { getProfile, getProjects, DISCIPLINE_LABELS, LEVEL_LABELS, getDeliverables, getCapabilities } from '../lib/publish';
import { DISCIPLINES } from '../content.config';

const me = await getProfile();
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 4);
const caps = await getCapabilities();
const deliverables = await getDeliverables();

const specialties = DISCIPLINES.map((d) => {
  const items = caps.filter((c) => c.data.discipline === d);
  const order = { professional: 0, academic: 1, developing: 2 } as const;
  items.sort((a, b) => order[a.data.level] - order[b.data.level]);
  return { d, items };
}).filter((s) => s.items.length > 0);

const index = [
  { n: '01', title: 'Introduction', text: 'Who I am and how I work', href: '#introduction' },
  { n: '02', title: 'Selected work', text: 'Theses and plan sets', href: '#work' },
  { n: '03', title: 'Specialties', text: 'Skills by experience level', href: '#specialties' },
  { n: '04', title: 'What I deliver', text: 'Outputs a team can expect', href: '#deliver' },
  { n: '05', title: 'Projects', text: 'The full, filterable library', href: '/projects' },
  { n: '06', title: 'Credentials', text: 'Registration and training', href: '/resume' },
];
---
<Base title="Home" bare>
  <!-- Cover -->
  <section class="spread cover" aria-labelledby="cover-title">
    <div class="pg cover-left">
      <p class="cover-kicker">Civil engineering</p>
      <h1 id="cover-title" class="cover-title" aria-label="Engineering portfolio">
        <span class="c1" aria-hidden="true">Port</span><span class="c2 script" aria-hidden="true">folio</span>
      </h1>
      <p class="cover-line">{me.headline}</p>
      <div class="actions">
        <a class="btn btn-solid" href="/projects">View projects</a>
        <a class="btn btn-line" href="/contact">Contact</a>
      </div>
      <p class="prepared"><span class="muted small">Prepared by</span><br /><strong>{me.short_name}, RCE</strong></p>
    </div>
    <div class="pg cover-right">
      <figure class="sketch">
        <img src="/img/cover-sketch.webp" alt="As-built front elevation of a five-storey university building, drafted for my BSCE thesis" />
      </figure>
      <ProfileHero />
    </div>
  </section>

  <!-- Index + Introduction -->
  <section class="spread section" id="introduction">
    <div class="pg">
      <h2>Index</h2>
      <ol class="index">
        {index.map((i) => (
          <li>
            <a href={i.href}>
              <span class="num">{i.n}</span>
              <span class="it">{i.title}</span>
              <span class="ix muted small">{i.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
    <div class="pg">
      <h2>Introduction</h2>
      <div class="intro">
        <div class="portrait">
          <img src="/img/rovic-jay-pinon.webp" alt={`Portrait of ${me.name}`} width="320" height="320" />
        </div>
        <div>
          <p class="who">{me.name}</p>
          <p class="muted small">{me.designation}<br />{me.location}</p>
        </div>
      </div>
      <p>{me.intro}</p>
      <ul class="dots small">
        {me.philosophy.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- Selected work -->
  <section class="sheet section" id="work">
    <div class="sec-head">
      <h2>Selected work</h2>
      <a href="/projects">All projects</a>
    </div>
    <ProjectRegister projects={featured} empty="Case studies are being prepared for publication." />
  </section>

  <!-- Specialties + Deliverables -->
  <section class="spread section">
    <div class="pg" id="specialties">
      <div class="sec-head">
        <h2>Specialties</h2>
        <a href="/capabilities">Full matrix</a>
      </div>
      {specialties.map((s) => (
        <div class="spec">
          <a class="spec-h" href={`/capabilities/${s.d}`}>{DISCIPLINE_LABELS[s.d]}</a>
          <ul>
            {s.items.map((i) => (
              <li><span>{i.data.name}</span><span class={`lvl lvl-${i.data.level}`}>{LEVEL_LABELS[i.data.level]}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="pg" id="deliver">
      <div class="sec-head">
        <h2>What I deliver</h2>
        <a href="/what-i-deliver">Scope and limits</a>
      </div>
      <ol class="deliv">
        {deliverables.map((d, i) => (
          <li>
            <span class="dn">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <a href={`/what-i-deliver#${d.id}`}>{d.data.title}</a>
              <p class="muted small">{d.data.basis}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  /* Cover */
  .cover { min-height: min(78vh, 640px); }
  .cover-left { display: flex; flex-direction: column; justify-content: center; position: relative; }
  .cover-left::before {
    content: ''; position: absolute; inset: 24px 24px auto 24px; height: 1px; background: var(--rule);
  }
  .cover-kicker { font-size: 1.15rem; font-weight: 500; color: var(--ink-strong); margin: 0 0 -0.2em; }
  .cover-title { margin: 0 0 18px; line-height: 0.95; color: var(--red); white-space: nowrap; }
  .c1 { font-size: var(--t-xxl); font-weight: 700; letter-spacing: -0.04em; }
  .c2 { font-size: calc(var(--t-xxl) * 1.02); color: var(--ink-strong); margin-left: -0.08em; position: relative; top: 0.12em; }
  .cover-line { max-width: 34ch; color: var(--steel); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin: 8px 0 28px; }
  .prepared { margin: 0; text-align: right; font-size: 0.92rem; }
  .prepared strong { color: var(--red); }
  .cover-right { display: flex; flex-direction: column; justify-content: center; gap: 28px; background:
      linear-gradient(var(--rule-soft) 1px, transparent 1px) 0 0 / 100% 48px,
      linear-gradient(90deg, var(--rule-soft) 1px, transparent 1px) 0 0 / 48px 100%; }

  .sketch { margin: 0; }
  .sketch img { width: 100%; mix-blend-mode: multiply; opacity: .9; }

  /* Index */
  .index { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 28px 18px; }
  .index a { display: grid; gap: 4px; text-decoration: none; color: var(--ink); }
  .num {
    width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid var(--red); color: var(--red);
    display: grid; place-items: center; font-size: 0.8rem; font-weight: 600; margin-bottom: 6px;
  }
  .index a:hover .num { background: var(--red); color: var(--white); }
  .it { font-weight: 600; color: var(--ink-strong); }
  .ix { line-height: 1.4; }
  @media (max-width: 560px) { .index { grid-template-columns: 1fr 1fr; } }

  /* Introduction */
  .intro { display: flex; align-items: center; gap: 20px; margin-bottom: 18px; }
  .portrait {
    width: 132px; height: 132px; border-radius: 50%; flex: none; padding: 5px;
    background: var(--red);
  }
  .portrait img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: var(--white); }
  .who { font-weight: 700; color: var(--ink-strong); margin: 0 0 4px; }

  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
  .sec-head h2 { margin: 0; }
  .sec-head a { font-size: var(--t-sm); font-weight: 600; }

  /* Specialties */
  .spec { padding: 12px 0; border-top: 1px solid var(--rule); }
  .spec-h { font-weight: 600; color: var(--ink-strong); text-decoration: none; display: block; margin-bottom: 6px; }
  .spec-h:hover { color: var(--red); }
  .spec ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 4px; }
  .spec li { display: flex; justify-content: space-between; gap: 12px; font-size: 0.86rem; }

  /* Deliverables */
  .deliv { list-style: none; padding: 0; margin: 0; }
  .deliv li { display: grid; grid-template-columns: 38px 1fr; gap: 12px; padding: 12px 0; border-top: 1px solid var(--rule); }
  .dn { color: var(--red); font-weight: 600; font-size: 0.85rem; padding-top: 2px; }
  .deliv a { font-weight: 600; color: var(--ink-strong); text-decoration: none; }
  .deliv a:hover { color: var(--red); text-decoration: underline; }
  .deliv p { margin: 2px 0 0; }

  @media (max-width: 860px) {
    .cover { min-height: 0; }
    .prepared { text-align: left; }
  }
</style>
