---
import { getProfile } from '../lib/publish';
const me = await getProfile();
const updated = new Date().toISOString().slice(0, 10);
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot">
      <div class="f-who">
        <p class="who">{me.name}{me.post_nominal && `, ${me.post_nominal}`}</p>
        <p class="muted small">{me.title} · {me.location}</p>
      </div>
      <ul class="f-contact small">
        {me.email && <li><a href={`mailto:${me.email}`}>{me.email}</a></li>}
        {me.linkedin && <li><a href={encodeURI(me.linkedin)} rel="me noopener" target="_blank">LinkedIn</a></li>}
        {me.resume_pdf && <li><a href={me.resume_pdf} download>Download CV</a></li>}
        <li><a href="/contact">Contact page</a></li>
      </ul>
    </div>
    <p class="disclaimer small">
      Technical materials on this site are portfolio samples of work I took part in. They do not replace the approved,
      signed engineering documents held by the owner, and they must not be used for construction. Signatures are covered,
      and my role on each project is stated on its page. <a href="/notice">Work labels and confidentiality</a>.
    </p>
    <p class="updated small muted">Last updated <time datetime={updated}>{updated}</time></p>
  </div>
</footer>

<style>
  .site-footer { padding: 28px 0 40px; border-top: 1px solid var(--rule); margin-top: 8px; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px 40px; align-items: flex-start; }
  .who { font-weight: 700; color: var(--ink-strong); margin: 0 0 2px; }
  .f-who p { margin: 0; }
  .f-contact { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 22px; margin: 0; padding: 0; }
  .f-contact a { color: var(--ink); }
  .f-contact a:hover { color: var(--red); }
  .disclaimer { color: var(--steel); max-width: 92ch; margin: 18px 0 6px; line-height: 1.5; }
  .updated { margin: 0; }
</style>
