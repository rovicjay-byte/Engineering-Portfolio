---
import Base from '../layouts/Base.astro';
import { getProfile, getProjects, DISCIPLINE_LABELS, WORK_TYPE_LABELS } from '../lib/publish';
import { getCapabilities } from '../lib/publish';
import { DISCIPLINES } from '../content.config';

const me = await getProfile();
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured && p.data.cover).slice(0, 3);
const caps = await getCapabilities();
const specialties = DISCIPLINES.filter((d) => caps.some((c) => c.data.discipline === d));

const facts = [
  { k: 'License', v: 'Registered Civil Engineer, PRC (2024)' },
  { k: 'Current role', v: 'Planning and Design, DPWH Ifugao 2nd District Engineering Office' },
  { k: 'Graduate study', v: 'MS Civil Engineering, Geotechnical (PUP), in progress' },
  { k: 'Degree', v: "BS Civil Engineering, Saint Mary's University (2024)" },
];
---
<Base title="Home" bare>
  <!-- Cover: who I am, at a glance -->
  <section class="spread cover" aria-labelledby="cover-name">
    <div class="pg cover-left">
      <p class="cover-kicker">Civil engineering</p>
      <p class="cover-title" aria-hidden="true">
        <span class="c1">Port</span><span class="c2 script">folio</span>
      </p>
      <h1 id="cover-name" class="name">{me.name}</h1>
      <p class="cover-line">{me.headline}</p>

      <dl class="keyfacts">
        {facts.map((f) => (
          <div><dt>{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>

      <div class="actions">
        <a class="btn btn-solid" href="/projects">View projects</a>
        <a class="btn btn-line" href="/resume">Resume</a>
        <a class="btn btn-line" href="/contact">Contact</a>
      </div>
    </div>

    <div class="pg cover-right">
      <div class="stage">
        <span class="disc" aria-hidden="true"></span>
        <img
          class="me"
          src="/img/rovic-jay-pinon-cutout.webp"
          alt={`Portrait of ${me.name}`}
          width="674" height="1000"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Selected work: three cards -->
  <section class="sheet section" id="work" aria-labelledby="work-h">
    <div class="sec-head">
      <h2 id="work-h">Selected work</h2>
      <a href="/projects">All projects</a>
    </div>
    <ul class="cards">
      {featured.map((p) => (
        <li>
          <a href={`/projects/${p.id}`} class="card">
            <img src={`/previews/${p.data.code}/${p.data.cover}`} alt="" loading="lazy" width="480" height="480" />
            <span class="card-meta"><span class="code">{p.data.code}</span><span class="muted">{WORK_TYPE_LABELS[p.data.work_type]}, {p.data.year}</span></span>
            <span class="card-title">{p.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Specialties and next steps -->
  <section class="sheet section more" aria-labelledby="spec-h">
    <div>
      <h2 id="spec-h">Specialties</h2>
      <ul class="chips">
        {specialties.map((d) => <li><a href={`/capabilities/${d}`}>{DISCIPLINE_LABELS[d]}</a></li>)}
      </ul>
    </div>
    <nav class="next" aria-label="More about my work">
      <a href="/capabilities"><strong>Capabilities</strong><span class="muted small">Skills by experience level</span></a>
      <a href="/what-i-deliver"><strong>What I deliver</strong><span class="muted small">Outputs a team can expect</span></a>
      <a href="/about"><strong>About</strong><span class="muted small">How I work</span></a>
    </nav>
  </section>
</Base>

<style>
  /* Cover */
  .cover { min-height: min(86vh, 720px); }
  .cover-left { display: flex; flex-direction: column; justify-content: center; }
  .cover-kicker { font-size: 1.05rem; font-weight: 500; color: var(--ink-strong); margin: 0 0 -0.3em; }
  .cover-title { margin: 0 0 14px; line-height: 0.95; color: var(--red); white-space: nowrap; }
  .c1 { font-size: clamp(3rem, 7vw, 5.6rem); font-weight: 700; letter-spacing: -0.04em; }
  .c2 { font-size: clamp(3.1rem, 7.2vw, 5.8rem); color: var(--ink-strong); margin-left: -0.08em; position: relative; top: 0.12em; }
  .name { font-size: clamp(1.45rem, 2.4vw, 1.9rem); color: var(--ink-strong); margin: 0 0 6px; letter-spacing: -0.01em; }
  .cover-line { max-width: 40ch; color: var(--steel); margin: 0 0 22px; }

  .keyfacts { margin: 0 0 26px; border-top: 1px solid var(--rule); }
  .keyfacts div { display: grid; grid-template-columns: 120px 1fr; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--rule); }
  .keyfacts dt { font-size: var(--t-sm); color: var(--red); font-weight: 600; }
  .keyfacts dd { margin: 0; font-size: 0.92rem; color: var(--ink); }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }

  /* Portrait */
  .cover-right {
    position: relative; overflow: hidden; display: flex; align-items: flex-end; justify-content: center;
    padding-bottom: 0 !important;
    background:
      linear-gradient(var(--rule-soft) 1px, transparent 1px) 0 0 / 100% 48px,
      linear-gradient(90deg, var(--rule-soft) 1px, transparent 1px) 0 0 / 48px 100%;
  }
  .stage { position: relative; width: min(100%, 470px); aspect-ratio: 674 / 1000; margin-top: 24px; }
  .disc {
    position: absolute; left: 50%; top: 9%; width: 96%; aspect-ratio: 1; transform: translateX(-50%);
    border-radius: 50%; background: var(--red);
  }
  .me { position: relative; display: block; width: 100%; height: auto; }

  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .sec-head h2 { margin: 0; }
  .sec-head a { font-size: var(--t-sm); font-weight: 600; }

  /* Selected work */
  .cards { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .card { display: grid; gap: 8px; text-decoration: none; color: var(--ink); }
  .card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--rule); background: var(--white); filter: grayscale(1); transition: filter .25s; }
  .card:hover img, .card:focus-visible img { filter: none; border-color: var(--red); }
  .card-meta { display: flex; gap: 10px; flex-wrap: wrap; font-size: 0.8rem; }
  .code { color: var(--red); font-weight: 600; }
  .card-title { font-weight: 600; color: var(--ink-strong); line-height: 1.3; }
  .card:hover .card-title { color: var(--red); }

  /* Specialties and next steps */
  .more { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; align-items: start; }
  .more h2 { margin: 0 0 14px; }
  .chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a {
    display: inline-block; padding: 7px 14px; border: 1px solid var(--rule); border-radius: 999px;
    background: var(--white); color: var(--ink-strong); text-decoration: none; font-size: 0.9rem;
  }
  .chips a:hover { border-color: var(--red); color: var(--red); }
  .next { display: grid; border-top: 1px solid var(--ink-strong); }
  .next a { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink-strong); }
  .next a:hover strong { color: var(--red); }

  @media (max-width: 860px) {
    .cover { min-height: 0; }
    .cover-right { order: -1; }
    .stage { width: min(78%, 340px); }
    .cards { grid-template-columns: 1fr; }
    .more { grid-template-columns: 1fr; gap: 28px; }
  }
  @media (max-width: 480px) { .keyfacts div { grid-template-columns: 1fr; gap: 2px; } }
</style>
