---
import Base from '../layouts/Base.astro';
import SoftwareSection from '../components/SoftwareSection.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ContactSection from '../components/ContactSection.astro';
import { getProfile, getProjectsByCode, STAGE_LABELS } from '../lib/publish';

const me = await getProfile();
const byCode = await getProjectsByCode();
const link = (code: string) => (byCode.get(code) ? `/projects/${byCode.get(code)!.id}` : undefined);

// B. Snapshot. Project figures are taken from the approved plan sets on this site.
const snapshot = [
  { k: 'Registered Civil Engineer', v: 'PRC, November 2024 licensure examination' },
  { k: 'BS Civil Engineering', v: "Saint Mary's University, July 2024" },
  { k: 'MS Civil Engineering', v: 'Geotechnical, Polytechnic University of the Philippines, in progress' },
  { k: '45 m bridge', v: 'Steel plate girder bridge: drafting and quantities', href: link('PRO-2026-001') },
  { k: '1.7 km mountain road', v: 'New road: design, drafting and quantities', href: link('PRO-2025-004') },
  { k: 'About 270 m road slip', v: 'Rehabilitation: design, drafting, quantities and estimate', href: link('PRO-2026-003') },
];

// B2. What I can offer. Each point is backed by a project on this site.
const offers = [
  { t: 'Complete plan sets, survey to approval', d: 'Plan and profile, cross sections and structure details produced in Civil 3D and taken through DPWH review to approval.', proof: 'Four approved plan sets; three are under construction.', codes: ['PRO-2025-004', 'PRO-2026-001'] },
  { t: 'Estimates ready for bidding', d: 'Quantity takeoffs, bill of quantities, detailed unit price analyses, program of works and approved budget, on DPWH forms.', proof: 'Approved budgets of Php 14.61M, Php 42.89M and Php 63.56M.', codes: ['PRO-2026-003', 'PRO-2025-005', 'PRO-2025-008'] },
  { t: 'Construction schedules', d: 'Bar charts with S-curves, critical path schedules and precedence networks that show the contractor what controls the duration.', proof: '112-day road slip schedule with CPM and PDM.', codes: ['PRO-2026-003'] },
  { t: 'Geotechnical judgement on steep ground', d: 'Staged slope stability analysis in GEO5 that finds the critical moment, not just the final state, and says what it means on site.', proof: 'Found the temporary cut critical at a factor of safety of 0.98.', codes: ['PRO-2026-002'] },
  { t: 'Hazard screening before design', d: 'Preliminary geohazard assessments to DPWH guidelines, with 13 QGIS hazard maps per site, so risks are known before money is committed.', proof: 'Three reports for FY 2026 road projects.', codes: ['PRO-2025-006'] },
  { t: 'Tools that save the team time', d: 'I build my own design spreadsheets, and I am developing Dynamo scripts for Civil 3D, to cut repeated design and drafting work.', proof: 'Covered RC canal design sheet to NSCP 2015, used on two projects.', codes: ['PRO-2025-007'] },
];

// C. Core specializations. Each bullet is backed by a project or by research on this site.
const specs = [
  {
    title: 'Highway engineering', tier: 'Primary', href: '/capabilities/highway',
    items: ['Roadway geometric design', 'Horizontal and vertical alignment', 'Road profiles and cross sections', 'Corridor modeling', 'Earthwork quantities', 'Pavement and drainage details'],
    proof: ['PRO-2025-004', 'PRO-2025-005', 'PRO-2026-003'],
  },
  {
    title: 'Civil 3D and detailed engineering plans', tier: 'Primary', href: '/capabilities/civil-design-cad',
    items: ['Surfaces from survey data', 'Alignment and profile development', 'Assemblies and corridors', 'Sample lines and cross sections', 'Quantity calculations', 'Plan set production'],
    proof: ['PRO-2026-001', 'PRO-2025-004', 'PRO-2026-003'],
  },
  {
    title: 'Geotechnical engineering', tier: 'Secondary', href: '/capabilities/geotechnical',
    items: ['Slope stability analysis (GEO5, Bishop)', 'Retaining and slope protection structures', 'Preliminary geohazard assessment', 'Bearing pressure checks for masonry walls', 'Reliability-based slope stability (MS research, in progress)'],
    proof: ['PRO-2026-002', 'PRO-2025-006', 'RES-2026-001'],
  },
  {
    title: 'GIS and spatial analysis', tier: 'Supporting', href: '/capabilities/gis-spatial',
    items: ['Geohazard mapping in QGIS', 'Terrain and site mapping', 'Survey data from RTK, total station and drone photogrammetry', 'Engineering location maps'],
    proof: ['PRO-2025-006'],
  },
];

// D. Featured projects
const featured = ['PRO-2026-001', 'PRO-2025-004', 'PRO-2026-003', 'PRO-2026-002'].map((c) => byCode.get(c)).filter(Boolean);
---
<Base title="Home" bare>
  <!-- A. Hero -->
  <section class="spread cover" aria-labelledby="hero-name">
    <div class="pg cover-left">
      <p class="kicker">{me.title}</p>
      <h1 id="hero-name" class="name">{me.name}{me.post_nominal && <span class="pn">, {me.post_nominal}</span>}</h1>
      <p class="intro">{me.headline}</p>
      <div class="actions">
        {me.resume_pdf && <a class="btn btn-solid" href={me.resume_pdf} download>Download CV</a>}
        <a class={me.resume_pdf ? 'btn btn-line' : 'btn btn-solid'} href="#contact">Work with me</a>
        <a class="btn btn-line" href="/projects">See my engineering work</a>
      </div>
      <ul class="sec-links">
        {me.linkedin && <li><a href={encodeURI(me.linkedin)} rel="me noopener" target="_blank">LinkedIn</a></li>}
        {me.email && <li><a href={`mailto:${me.email}`}>{me.email}</a></li>}
        {me.portfolio_pdf && <li><a href={me.portfolio_pdf} download>Technical portfolio (PDF)</a></li>}
        <li><a href="/resume">Resume and documents</a></li>
      </ul>
    </div>
    <div class="pg cover-right">
      <img class="portrait" src="/img/rovic-jay-pinon-cover.webp" alt={`Portrait of ${me.name}`} width="1086" height="1448" fetchpriority="high" />
    </div>
  </section>

  <!-- B. Professional snapshot -->
  <section class="sheet section snap" aria-labelledby="snap-h">
    <h2 id="snap-h" class="visually-hidden">Professional snapshot</h2>
    <dl class="snap-grid">
      {snapshot.map((s) => (
        <div class="snap-item">
          <dt>{s.href ? <a href={s.href}>{s.k}</a> : s.k}</dt>
          <dd>{s.v}</dd>
        </div>
      ))}
    </dl>
    <p class="small muted snap-note">Selected projects from my DPWH work. Every project page states exactly what I delivered.</p>
  </section>

  <!-- B2. What I can offer -->
  <section class="sheet section" aria-labelledby="offer-h">
    <div class="sec-head">
      <div>
        <h2 id="offer-h">What I can offer your team</h2>
        <p class="sec-sub">An engineer who can take a road project from the survey to an approved plan set, a priced estimate and a schedule, and check the ground it sits on.</p>
      </div>
      <a href="/what-i-deliver">Outputs in detail</a>
    </div>
    <ul class="offer-grid">
      {offers.map((o, n) => {
        const ps = o.codes.map((c) => byCode.get(c)).filter(Boolean);
        return (
          <li class="offer">
            <span class="offer-n">{String(n + 1).padStart(2, '0')}</span>
            <h3>{o.t}</h3>
            <p>{o.d}</p>
            <p class="offer-proof"><strong>Proof:</strong> {o.proof}{ps.length > 0 && <> See {ps.map((p, i) => <>{i > 0 && ', '}<a href={`/projects/${p!.id}`}>{p!.data.code}</a></>)}.</>}</p>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- C. Core specializations -->
  <section class="sheet section" aria-labelledby="spec-h">
    <div class="sec-head">
      <div>
        <h2 id="spec-h">Core specializations</h2>
        <p class="sec-sub">Highway infrastructure is my core. Geotechnical engineering is the depth I am building on top of it.</p>
      </div>
      <a href="/capabilities">All capabilities</a>
    </div>
    <ul class="spec-grid">
      {specs.map((s) => {
        const proof = s.proof.map((c) => byCode.get(c)).filter(Boolean);
        return (
          <li class="spec">
            <span class="tier">{s.tier}</span>
            <h3><a href={s.href}>{s.title}</a></h3>
            <ul class="spec-items">{s.items.map((i) => <li>{i}</li>)}</ul>
            {proof.length > 0 && (
              <p class="spec-proof">Shown in: {proof.map((p, i) => <>{i > 0 && ', '}<a href={`/projects/${p!.id}`}>{p!.data.code}</a></>)}</p>
            )}
          </li>
        );
      })}
    </ul>
  </section>

  <!-- D. Featured engineering projects -->
  <section class="sheet section" id="work" aria-labelledby="work-h">
    <div class="sec-head">
      <div>
        <h2 id="work-h">Work you can inspect</h2>
        <p class="sec-sub">Approved DPWH plan sets and analyses, shown sheet by sheet. Open any drawing and zoom in to check the detail.</p>
      </div>
      <a href="/projects">All projects</a>
    </div>
    <ul class="feat">
      {featured.map((p) => {
        const d = p!.data;
        return (
          <li class="feat-item">
            <a class="feat-thumb" href={`/projects/${p!.id}`} tabindex="-1" aria-hidden="true">
              <img src={`/thumbs/${d.code}/${d.cover}`} alt="" loading="lazy" decoding="async" width="640" height="480" />
            </a>
            <div class="feat-body">
              <p class="feat-cat"><span class="code">{d.code}</span> · {d.project_type}</p>
              <h3><a href={`/projects/${p!.id}`}>{d.title}</a></h3>
              <dl class="feat-facts">
                {d.dimensions && <><dt>Size</dt><dd>{d.dimensions}</dd></>}
                {d.location_public && <><dt>Location</dt><dd>{d.location_public}</dd></>}
                <dt>My part</dt><dd>{d.role}</dd>
                {d.deliverables.length > 0 && <><dt>Deliverables</dt><dd>{d.deliverables.slice(0, 3).join('; ')}</dd></>}
                <dt>Status</dt><dd>{d.stage ? STAGE_LABELS[d.stage] : `My work ${d.status}`}</dd>
              </dl>
              <a class="feat-link" href={`/projects/${p!.id}`}>View case study</a>
            </div>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- E. Software and technical capabilities -->
  <section class="sheet section" aria-labelledby="sw-h">
    <div class="sec-head">
      <div>
        <h2 id="sw-h">Tools I deliver with</h2>
        <p class="sec-sub">What I produce in each tool, with projects that show it. Labels mark professional use, academic use, or a skill I am building now.</p>
      </div>
    </div>
    <SoftwareSection />
  </section>

  <!-- F. Professional experience -->
  <section class="sheet section" aria-labelledby="exp-h">
    <div class="sec-head">
      <div><h2 id="exp-h">Professional experience</h2></div>
      <a href="/experience">Full experience</a>
    </div>
    <ExperienceTimeline compact />
  </section>

  <!-- G. Education and credentials -->
  <section class="sheet section" aria-labelledby="edu-h">
    <div class="sec-head">
      <div><h2 id="edu-h">Education and credentials</h2></div>
      <a href="/resume#credentials">Credentials and certificates</a>
    </div>
    <ul class="edu">
      {me.credentials.map((c) => (
        <li><span class="edu-k">{c.name}</span><span>{c.detail}</span></li>
      ))}
      {me.education.map((e) => (
        <li>
          <span class="edu-k">{e.degree}</span>
          <span>{e.school}, {e.period}{e.notes.length > 0 && <ul class="edu-notes">{e.notes.map((n) => <li>{n}</li>)}</ul>}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- H. Contact -->
  <section class="sheet section" id="contact">
    <ContactSection />
  </section>
</Base>

<style>
  /* A. Hero */
  .cover { min-height: min(86vh, 740px); }
  .cover-left { display: flex; flex-direction: column; justify-content: center; }
  .kicker { font-size: 0.95rem; font-weight: 600; color: var(--red); margin: 0 0 12px; }
  .name { font-size: clamp(2.2rem, 4.6vw, 3.4rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--ink-strong); margin: 0 0 18px; }
  .pn { font-weight: 500; color: var(--steel); }
  .intro { font-size: 1.05rem; line-height: 1.6; color: var(--ink); max-width: 52ch; margin: 0 0 26px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .sec-links { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 20px; padding: 0; margin: 20px 0 0; font-size: var(--t-sm); }
  .sec-links a { color: var(--steel); }
  .sec-links a:hover { color: var(--red); }
  .cover-right { position: relative; overflow: hidden; padding: 0 !important; background: #f8f7f4; }
  .portrait { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 100%; }

  /* B. Snapshot */
  .snap { padding-top: 26px !important; padding-bottom: 22px !important; }
  .snap-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0; margin: 0; }
  .snap-item { padding: 4px 18px; border-left: 1px solid var(--rule); }
  .snap-item:first-child { border-left: 0; padding-left: 0; }
  .snap-item dt { font-weight: 700; color: var(--ink-strong); font-size: 0.98rem; margin-bottom: 4px; line-height: 1.25; }
  .snap-item dt a { color: inherit; text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 3px; }
  .snap-item dt a:hover { color: var(--red); text-decoration-color: var(--red); }
  .snap-item dd { margin: 0; font-size: 0.82rem; color: var(--steel); line-height: 1.4; }
  .snap-note { margin: 16px 0 0; }

  .sec-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .sec-head h2 { margin: 0; }
  .sec-sub { margin: 6px 0 0; color: var(--steel); max-width: 62ch; }

  /* C. Specializations */
  .spec-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--ink-strong); }
  .spec { padding: 18px 20px 6px; border-left: 1px solid var(--rule); display: flex; flex-direction: column; }
  .spec:first-child { border-left: 0; padding-left: 0; }
  .tier { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--red); }
  .spec h3 { font-size: 1.06rem; margin: 6px 0 10px; line-height: 1.25; }
  .spec h3 a { color: var(--ink-strong); text-decoration: none; }
  .spec h3 a:hover { color: var(--red); }
  .spec-items { margin: 0; padding-left: 1.05em; font-size: 0.9rem; }
  .spec-items li { margin: 3px 0; }
  .spec-proof { margin: auto 0 0; padding-top: 12px; font-size: 0.8rem; color: var(--steel); }

  /* D. Featured */
  .feat { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 34px 32px; }
  .feat-item { display: grid; grid-template-columns: minmax(0, 42%) 1fr; gap: 18px; align-items: start; }
  .feat-thumb { display: block; aspect-ratio: 4 / 3; border: 1px solid var(--rule); overflow: hidden; background: var(--white); }
  .feat-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .feat-thumb:hover { border-color: var(--red); }
  .feat-cat { margin: 0 0 4px; font-size: 0.8rem; color: var(--steel); }
  .code { color: var(--red); font-weight: 700; }
  .feat-body h3 { font-size: 1.02rem; line-height: 1.3; margin: 0 0 10px; }
  .feat-body h3 a { color: var(--ink-strong); text-decoration: none; }
  .feat-body h3 a:hover { color: var(--red); }
  .feat-facts { display: grid; grid-template-columns: 88px 1fr; gap: 3px 10px; margin: 0 0 10px; font-size: 0.84rem; }
  .feat-facts dt { color: var(--steel); }
  .feat-facts dd { margin: 0; }
  .feat-link { font-size: var(--t-sm); font-weight: 600; }

  /* G. Education */
  .edu { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--ink-strong); }
  .edu > li { display: grid; grid-template-columns: 300px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .edu-k { font-weight: 700; color: var(--ink-strong); }
  .edu-notes { margin: 6px 0 0; padding-left: 1.1em; font-size: 0.9rem; color: var(--steel); }

  /* B2. Offer */
  .offer-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--ink-strong); }
  .offer { padding: 20px 22px 18px; border-bottom: 1px solid var(--rule); border-left: 1px solid var(--rule); display: flex; flex-direction: column; }
  .offer:nth-child(3n + 1) { border-left: 0; padding-left: 0; }
  .offer-n { font-size: 0.78rem; font-weight: 700; color: var(--red); }
  .offer h3 { font-size: 1.08rem; line-height: 1.25; margin: 4px 0 8px; color: var(--ink-strong); }
  .offer p { margin: 0; font-size: 0.92rem; }
  .offer-proof { margin-top: auto !important; padding-top: 12px; font-size: 0.84rem !important; color: var(--steel); }
  .offer-proof strong { color: var(--ink-strong); }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 960px) {
    .offer-grid { grid-template-columns: 1fr 1fr; }
    .offer:nth-child(3n + 1) { border-left: 1px solid var(--rule); padding-left: 22px; }
    .offer:nth-child(2n + 1) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 600px) {
    .offer-grid { grid-template-columns: 1fr; }
    .offer, .offer:nth-child(3n + 1) { border-left: 0; padding-left: 0; }
  }
  @media (max-width: 1100px) {
    .snap-grid { grid-template-columns: repeat(3, 1fr); gap: 16px 0; }
    .snap-item:nth-child(3n + 1) { border-left: 0; padding-left: 0; }
    .spec-grid { grid-template-columns: 1fr 1fr; }
    .spec:nth-child(3) { border-left: 0; padding-left: 0; }
    .feat { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .cover { min-height: 0; }
    .cover-right { order: -1; min-height: 420px; }
  }
  @media (max-width: 640px) {
    .snap-grid { grid-template-columns: 1fr 1fr; }
    .snap-item { padding: 0 0 0 12px; }
    .snap-item:nth-child(3n + 1) { border-left: 1px solid var(--rule); padding-left: 12px; }
    .snap-item:nth-child(2n + 1) { border-left: 0; padding-left: 0; }
    .spec-grid { grid-template-columns: 1fr; }
    .spec { border-left: 0; padding-left: 0; border-bottom: 1px solid var(--rule); padding-bottom: 14px; }
    .feat-item { grid-template-columns: 1fr; }
    .edu > li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
